# =========================
# Build directories
# =========================
build/
cmake-build-*/
out/

# =========================
# CMake generated files
# =========================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
_install/

# =========================
# Compiled binaries / objects
# =========================
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# =========================
# Debug / profiling output
# =========================
*.dSYM/
*.gcda
*.gcno
*.gcov

# =========================
# IDE / editor files
# =========================
.vscode/
.idea/
*.code-workspace

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary / backup files
# =========================
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# =========================
# Python cache
# (useful if experiments/scripts
# are added later)
# =========================
__pycache__/
*.py[cod]

# =========================
# Local environment / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Logs
# =========================
*.log